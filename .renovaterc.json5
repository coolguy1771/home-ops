{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#10.0.1",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#10.0.1",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#10.0.1",
    "github>coolguy1771/home-ops//.renovate/local.json5",
    ":semanticCommits",
    ":timezone(America/New_York)",
  ],
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [
    "**/*.sops.*",
    "**/resources/**",
  ],
}
